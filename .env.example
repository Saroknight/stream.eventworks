# Copy to .env for local overrides. Everything here is optional when running locally.

# Port the web app listens on
PORT=3000

# Public address of the site (used for links printed by `npm run admin-link`)
PUBLIC_URL=http://localhost:3000

# LiveKit credentials. The local dev server (`livekit-server --dev`) uses devkey / secret.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Where browsers reach LiveKit. Leave empty to derive it from the page address
# (local: ws://<host>:7880, https: wss://<same domain>).
LIVEKIT_PUBLIC_URL=

# Signs invite, device and admin links. Locally one is generated into data/auth-secret.
AUTH_SECRET=

# How long an empty room stays open before it ends, in seconds (default 300 = 5 minutes)
ROOM_EMPTY_SECONDS=300
