# Copy to .env for local overrides. Every value here is optional when running locally.

# Port the web app listens on
PORT=3000

# LiveKit credentials. Local dev server (`livekit-server --dev`) uses devkey / secret.
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=secret

# Where browsers reach LiveKit. Leave empty to derive it from the page address
# (local: ws://<host>:7880, https: wss://<same domain>).
LIVEKIT_PUBLIC_URL=

# If set, creating a room requires this password (always set it on a public server)
ADMIN_PASSWORD=
