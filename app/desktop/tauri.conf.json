{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Streamroom Live",
  "mainBinaryName": "Streamroom Live",
  "identifier": "click.eventworks.streamroom",
  "build": {
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "Streamroom Live",
        "width": 440,
        "height": 660,
        "minWidth": 380,
        "minHeight": 520,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "publisher": "Streamroom",
    "shortDescription": "Stream your screen into Streamroom",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "displayLanguageSelector": false
      }
    }
  },
  "plugins": {
    "deep-link": {
      "desktop": {
        "schemes": ["streamroom"]
      }
    }
  }
}
